# Browser-visible configuration for https://postyst.techyst.net.
# Paste into Vercel → Settings → Environment Variables, or import with
#   vercel env add < .env.vercel
# Server secrets do not belong here; they are compiled into the bundle.
NEXT_PUBLIC_BACKEND_URL=https://api.postyst.techyst.net
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=https://api.postyst.techyst.net/uploads
