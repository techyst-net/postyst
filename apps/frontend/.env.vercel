# Browser-visible configuration for social.techyst.net.
# Paste into Vercel → Settings → Environment Variables, or import with
#   vercel env add < .env.vercel
# Server secrets do not belong here; they are compiled into the bundle.
NEXT_PUBLIC_BACKEND_URL=https://social-api.techyst.net
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=https://social-api.techyst.net/uploads
