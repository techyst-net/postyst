# Postyst ships only Dockerfile.dev. This is the same build without the dev
# tooling, running backend + workers + cron under pm2 in one container.
FROM node:22.20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ make python3-pip bash nginx curl openssl \
 && rm -rf /var/lib/apt/lists/*
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

# The root `postinstall` runs `prisma generate` against
# libraries/nestjs-libraries/.../schema.prisma, which is not in the context yet
# at install time — hence `--ignore-scripts` here and an explicit generate once
# the source is present.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
RUN pnpm install --no-frozen-lockfile --ignore-scripts

COPY . .
RUN pnpm run prisma-generate
RUN pnpm run build

ENV NODE_ENV=production
EXPOSE 5000
CMD ["pnpm", "run", "pm2"]
